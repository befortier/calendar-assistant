{
  "name": "calendar-assistant",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace=app",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:server\"",
    "lint": "npm run lint --workspace=app && npm run lint --workspace=server",
    "lint:fix": "npm run lint:fix --workspace=app && npm run lint:fix --workspace=server",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
