{
  "name": "calendar-assistant",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "dev:app": "npm run dev --workspace=app",
    "dev:server": "npm run dev --workspace=server",
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:server\""
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "concurrently": "^8.2.2",
    "supertest": "^7.2.2"
  }
}
